<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <add key="github" value="https://nuget.pkg.github.com/MaciejMajchrzak/index.json" />
  </packageSources>
  <packageSourceCredentials>
    <github>
      <add key="Username" value="MaciejMajchrzak" />
      <!-- Use a PAT with read:packages scope stored in NUGET_AUTH_TOKEN env var.
           Run once locally: export NUGET_AUTH_TOKEN=ghp_your_token -->
      <add key="ClearTextPassword" value="%NUGET_AUTH_TOKEN%" />
    </github>
  </packageSourceCredentials>
</configuration>
