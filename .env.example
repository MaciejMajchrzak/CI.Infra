# Copy this to .env on the droplet and fill in real values.
# Never commit .env to git.

POSTGRES_PASSWORD=change_me
RABBITMQ_PASSWORD=change_me
KEYCLOAK_ADMIN_PASSWORD=change_me
GRAFANA_PASSWORD=change_me
OPENBAO_ROOT_TOKEN=change_me
BAGET_API_KEY=change_me

# Stripe — get from https://dashboard.stripe.com/apikeys (use test keys for dev)
STRIPE_SECRET_KEY=sk_test_change_me
STRIPE_WEBHOOK_SECRET=whsec_change_me
# Platform fee in basis points (250 = 2.5%)
STRIPE_PLATFORM_FEE_BPS=250

# GitHub PAT with read:packages scope — used by the droplet to pull GHCR images.
GHCR_TOKEN=ghp_your_token_here
GHCR_USER=MaciejMajchrzak
